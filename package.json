{
  "name": "@cityssm/voterview-api",
  "version": "0.3.0",
  "description": "An unofficial wrapper around the VoterView Online Voter Services REST API",
  "keywords": [
    "voterview"
  ],
  "homepage": "https://github.com/cityssm/node-voterview-api#readme",
  "bugs": {
    "url": "https://github.com/cityssm/node-voterview-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityssm/node-voterview-api.git"
  },
  "license": "MIT",
  "author": "The Corporation of the City of Sault Ste. Marie",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./debug": "./debug.config.js",
    "./types": "./types.js"
  },
  "files": [
    "helpers",
    "processors",
    "utilities",
    "debug.config.*",
    "index.*",
    "types.*"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:api": "node --test \"test/api.test.js\"",
    "test:helpers": "node --test \"test/helpers.test.js\""
  },
  "dependencies": {
    "@cacheable/node-cache": "^3.1.1",
    "@cityssm/mpac-tools": "^0.3.0",
    "@cityssm/to-millis": "^1.0.1",
    "@cityssm/utils-datetime": "^1.3.0",
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^26.1.2",
    "eslint-config-cityssm": "^43.0.0",
    "prettier-config-cityssm": "^2.1.3"
  }
}
